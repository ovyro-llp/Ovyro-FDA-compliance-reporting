generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANT CORE ─────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  plan        String   @default("STARTER") // TRIAL | STARTER | PRO | ENTERPRISE
  status      String   @default("ACTIVE")  // ACTIVE | SUSPENDED | CANCELLED
  settings    String   @default("{}")      // Timezone, shift timings, branding, custom roles (JSON)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contactPhone    String?
  contactEmail    String?
  monthlyFee      Float            @default(500)
  billingStatus   String           @default("PENDING") // PAID | PENDING | OVERDUE | CANCELLED
  nextBillingDate DateTime?

  // Dodo Payments Subscription & Sync Fields
  dodoSubscriptionId String?       @unique
  dodoCustomerId     String?
  dodoProductId      String?
  billingInterval    String?       @default("MONTHLY") // MONTHLY | ANNUAL
  paymentProvider    String        @default("DODO_PAYMENTS")
  lastPaymentDate    DateTime?

  users           User[]
  outlets         Outlet[]
  templates       FormTemplate[]
  submissions     FormSubmission[]
  roles           CustomRole[]
  billingRecords  ClientBilling[]
}

model ClientBilling {
  id              String       @id @default(cuid())
  organizationId  String
  amount          Float        @default(500)
  currency        String       @default("INR")
  billingCycle    String       @default("MONTHLY") // MONTHLY | ANNUAL
  status          String       @default("PENDING") // PAID | PENDING | OVERDUE | CANCELLED
  invoiceNumber   String?
  dueDate         DateTime     @default(now())
  paidAt          DateTime?
  paymentMethod   String?      @default("DODO_PAYMENTS")
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Dodo Payments Transaction & Checkout Fields
  dodoPaymentId      String?
  dodoSessionId      String?
  dodoSubscriptionId String?
  checkoutUrl        String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([dodoSessionId])
  @@index([dodoSubscriptionId])
}

model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  name           String       // e.g. "Head Chef", "Sanitation Supervisor", "Line Operator", "Store Manager"
  description    String?
  permissions    String       @default("[\"submit_checklists\"]") // JSON array of permission strings
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Outlet {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String?       // e.g. "MUM-01", "OUT-BKR"
  type           String        @default("RESTAURANT") // RESTAURANT, BAKERY, FACTORY, WAREHOUSE, CLOUD_KITCHEN
  address        String?
  icon           String        @default("📍")
  shifts         String        @default("[\"Morning\", \"Afternoon\", \"Evening\", \"Night\"]") // JSON array
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userOutlets    UserOutlet[]
  outletTemplates OutletTemplate[]
  submissions    FormSubmission[]

  @@index([organizationId])
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  email          String        @unique
  passwordHash   String
  role           String        @default("OPERATOR") // Base role: ORG_ADMIN, MANAGER, SUPERVISOR, OPERATOR
  customRoleId   String?
  permissions    String        @default("[\"submit_checklists\"]") // Granular permission keys JSON
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole     CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  userOutlets    UserOutlet[]
  templateAccess UserTemplateAccess[]
  submissions    FormSubmission[]

  @@index([organizationId])
  @@index([customRoleId])
}

model UserOutlet {
  id        String   @id @default(cuid())
  userId    String
  outletId  String
  role      String   @default("OPERATOR")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([userId])
  @@index([outletId])
}

model UserTemplateAccess {
  id         String       @id @default(cuid())
  userId     String
  templateId String
  canSubmit  Boolean      @default(true)
  canVerify  Boolean      @default(false)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
}

// ─── DYNAMIC FORM TEMPLATES ───────────────────────────────────────────────────

model FormTemplate {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  slug           String
  category       String           @default("CUSTOM")
  icon           String           @default("📋")
  description    String?
  frequency      String           @default("DAILY")
  version        Int              @default(1)
  isArchived     Boolean          @default(false)
  schema         String           @default("{\"sections\":[]}") // Dynamic JSON config
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outletTemplates OutletTemplate[]
  userAccess     UserTemplateAccess[]
  submissions    FormSubmission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OutletTemplate {
  id         String       @id @default(cuid())
  outletId   String
  templateId String
  order      Int          @default(0)
  isEnabled  Boolean      @default(true)

  outlet     Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([outletId, templateId])
  @@index([outletId])
  @@index([templateId])
}

// ─── DYNAMIC SUBMISSIONS & AUDIT LOG ──────────────────────────────────────────

model FormSubmission {
  id               String       @id @default(cuid())
  organizationId   String
  outletId         String
  templateId       String
  templateVersion  Int          @default(1)
  date             String       // YYYY-MM-DD or YYYY-MM for monthly
  shift            String?      // Morning, Afternoon, Evening, Night, or null
  submittedById    String
  supervisorName   String       @default("")
  supervisorSigned Boolean      @default(false)
  signatureData    String?
  complianceScore  Float?       // 0-100% compliance calculated
  data             String       @default("{}") // Dynamic JSON payload of completed checks
  comments         String       @default("")
  correctiveAction String       @default("")
  status           String       @default("SUBMITTED") // DRAFT, SUBMITTED, VERIFIED, FLAGGED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet           Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  template         FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submittedBy      User         @relation(fields: [submittedById], references: [id])

  @@index([organizationId, outletId, date])
  @@index([outletId, templateId, date])
  @@index([submittedById])
}
